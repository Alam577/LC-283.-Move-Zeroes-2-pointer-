class Solution {
    public boolean isPowerOfTwo(int n) {
        if(n==1)
        {
            return true;
        }
        if(n==0 || n%2!=0) //if it is a 0 or odd num it will not a power of 2
        {
            return false;
        }
        return isPowerOfTwo(n/2); //using recursion
        
        
    }
}
